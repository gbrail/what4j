load("@rules_java//java:defs.bzl", "java_library")
load("@rules_rhino//java:defs.bzl", "java_test_suite")

java_library(
    name = "core",
    srcs = glob(["src/**/*.java"]),
    resources = glob(["scripts/**"]),
    deps = [
        "@maven//:com_ibm_icu_icu4j",
        "@rhino//rhino",
    ],
)

java_test_suite(
    name = "core_tests",
    srcs = glob(["test/**/*Test.java"]),
    data = ["//:wpt_source"],
    deps = [
        ":core",
        "//testrunner",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_junit_jupiter_junit_jupiter_params",
        "@rhino//rhino",
    ],
)
