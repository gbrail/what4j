load("@rules_rhino//babel:defs.bzl", "babel_preprocess", "babel_preprocess_html", "npm_install")
load("@rules_rhino//java:defs.bzl", "google_java_format_check", "google_java_format_fix")

npm_install(
    name = "babel_deps",
    package_json = "//babel:package.json",
    package_lock = "//babel:package-lock.json",
)

babel_preprocess(
    name = "harness_source",
    srcs = ["wpt/resources/testharness.js"],
    config = "//babel:babel.config.json",
    npm = ":babel_deps",
    visibility = ["//visibility:public"],
)

babel_preprocess(
    name = "wpt_js_source",
    srcs = [":wpt_js_files"],
    config = "//babel:babel.config.json",
    npm = ":babel_deps",
)

babel_preprocess_html(
    name = "wpt_html_source",
    srcs = [":wpt_html_files"],
    config = "//babel:babel.config.json",
    npm = ":babel_deps",
)

filegroup(
    name = "wpt_source",
    srcs = [
        ":wpt_html_source",
        ":wpt_js_source",
        ":wpt_resources",
    ],
    visibility = ["//visibility:public"],
)

#google_java_format_check(
#    name = "checkformat",
#    files = glob(["**/*.java"]),
#    tags = ["manual"],
#)

google_java_format_fix(
    name = "fixformat",
)

# Supported HTML test files, to be preprocessed with Babel.
# Various tests will pull these preprocessed directories.
filegroup(
    name = "wpt_html_files",
    srcs = glob(
        [
            "wpt/js/builtins/*.html",
        ],
        exclude = [
            "**/*hasOwnProperty-order*",
            "**/*.sub.html",
        ],
    ),
)

# Supported JavaScript test scripts, to be preprocessed with Babel.
# Various tests will pull these preprocessed directories.
filegroup(
    name = "wpt_js_files",
    srcs = glob(
        [
            "wpt/common/*.js",
            "wpt/encoding/*.js",
            "wpt/encoding/resources/*.js",
            "wpt/hr-time/*.any.js",
            "wpt/js/builtins/*.js",
            "wpt/streams/*.any.js",
            "wpt/streams/piping/*.any.js",
            "wpt/streams/readable-streams/*.any.js",
            "wpt/streams/resources/*.js",
            "wpt/streams/writable-streams/*.any.js",
            "wpt/url/resources/*.js",
            "wpt/url/*.any.js",
            "wpt/urlpattern/resources/*.js",
            "wpt/urlpattern/*.any.js",
        ],
        exclude = [
            "wpt/common/empty.js",
            # Needs the WebIDL test harness (wpt/resources/idlharness.js,
            # WebIDLParser.js), which is not wired up yet.
            "wpt/url/idlharness.any.js",
            # Needs the Fetch `Request` and `Response` classes, which are not
            # implemented yet.
            "wpt/url/urlencoded-parser.any.js",
            # Duplicate coverage of the non-HTTPS URLPattern tests.
            "wpt/urlpattern/*.https.any.js",
            # Tentative URLPattern APIs are not implemented yet.
            "wpt/urlpattern/*tentative*",
            # Needs the WebIDL test harness (wpt/resources/idlharness.js,
            # WebIDLParser.js), which is not wired up yet.
            "wpt/streams/idlharness.any.js",
            # Needs async generator support, which Babel leaves untranspiled
            # and the pinned Rhino build cannot parse.
            "wpt/streams/readable-streams/async-iterator.any.js",
            "wpt/streams/readable-streams/from.any.js",
            # Needs a GC trigger hook (wpt/common/gc.js), which is not
            # available in Rhino.
            "wpt/streams/readable-streams/garbage-collection.any.js",
            "wpt/streams/writable-streams/garbage-collection.any.js",
            # Needs the TransformStream class, which is not implemented yet.
            "wpt/streams/piping/pipe-through.any.js",
            "wpt/streams/piping/throwing-options.any.js",
            "wpt/streams/piping/transform-streams.any.js",
            # Not passable by a pure-JS implementation: the pipe loop
            # cannot defer the chunk-to-write transition without
            # Promise.prototype.then, which the test patches. The
            # standard's reference implementation excludes it too
            # (whatwg/streams#1243).
            "wpt/streams/piping/general-addition.any.js",
            # One test needs readable byte streams (type: "bytes"),
            # which are not implemented yet.
            "wpt/streams/piping/abort.any.js",
            # Needs pipeTo/pipeThrough (WritableStream), which is not
            # implemented yet.
            "wpt/streams/readable-streams/patched-global.any.js",
            "wpt/streams/readable-streams/reentrant-strategies.any.js",
            "wpt/streams/readable-streams/templated.any.js",
            # Tentative ReadableStream APIs are not implemented yet.
            "wpt/streams/readable-streams/owning-type*",
        ],
    ),
)

# Other test files that will not be preprocessed
filegroup(
    name = "wpt_resources",
    srcs = glob([
        "wpt/common/empty.js",
        "wpt/url/resources/*.json",
        "wpt/urlpattern/resources/*.json",
    ]),
)
