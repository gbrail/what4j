load("@rules_rhino//babel:defs.bzl", "babel_preprocess", "npm_install")
load("@rules_rhino//java:defs.bzl", "google_java_format_check", "google_java_format_fix")

npm_install(
    name = "babel_deps",
    package_json = "//babel:package.json",
    package_lock = "//babel:package-lock.json",
)

babel_preprocess(
    name = "harness_source",
    srcs = ["wpt/resources/testharness.js"],
    config = "//babel:babel.config.json",
    npm = ":babel_deps",
    visibility = ["//visibility:public"],
)

babel_preprocess(
    name = "wpt_js_source",
    srcs = glob([
        "wpt/js/**/*.js",
    ]),
    config = "//babel:babel.config.json",
    npm = ":babel_deps",
)

filegroup(
    name = "wpt_source",
    srcs = glob([
        "wpt/js/**/*.html",
    ]) + [
        ":wpt_js_source",
    ],
    visibility = ["//visibility:public"],
)

google_java_format_check(
    name = "checkformat",
    files = glob(["**/*.java"]),
    tags = ["manual"],
)

google_java_format_fix(
    name = "fixformat",
)
