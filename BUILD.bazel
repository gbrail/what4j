load("@rules_rhino//babel:defs.bzl", "babel_preprocess", "babel_preprocess_html", "npm_install")
load("@rules_rhino//java:defs.bzl", "google_java_format_check", "google_java_format_fix")

npm_install(
    name = "babel_deps",
    package_json = "//babel:package.json",
    package_lock = "//babel:package-lock.json",
)

babel_preprocess(
    name = "harness_source",
    srcs = ["wpt/resources/testharness.js"],
    config = "//babel:babel.config.json",
    npm = ":babel_deps",
    visibility = ["//visibility:public"],
)

babel_preprocess(
    name = "wpt_js_source",
    srcs = [":wpt_js_files"],
    config = "//babel:babel.config.json",
    npm = ":babel_deps",
)

babel_preprocess_html(
    name = "wpt_html_source",
    srcs = [":wpt_html_files"],
    config = "//babel:babel.config.json",
    npm = ":babel_deps",
)

filegroup(
    name = "wpt_source",
    srcs = [
        ":wpt_html_source",
        ":wpt_js_source",
        ":wpt_resources",
    ],
    visibility = ["//visibility:public"],
)

#google_java_format_check(
#    name = "checkformat",
#    files = glob(["**/*.java"]),
#    tags = ["manual"],
#)

google_java_format_fix(
    name = "fixformat",
)

# Supported HTML test files, to be preprocessed with Babel.
# Various tests will pull these preprocessed directories.
filegroup(
    name = "wpt_html_files",
    srcs = glob(
        [
            "wpt/js/builtins/*.html",
        ],
        exclude = [
            "**/*hasOwnProperty-order*",
            "**/*.sub.html",
        ],
    ),
)

# Supported JavaScript test scripts, to be preprocessed with Babel.
# Various tests will pull these preprocessed directories and locally
# exclude tests that do not pass.
filegroup(
    name = "wpt_js_files",
    srcs = glob(
        [
            "wpt/common/*.js",
            "wpt/encoding/*.js",
            "wpt/encoding/resources/*.js",
            "wpt/hr-time/*.any.js",
            "wpt/js/builtins/*.js",
            "wpt/streams/*.any.js",
            "wpt/streams/**/crashtests/*.any.js",
            "wpt/streams/piping/*.any.js",
            "wpt/streams/readable-streams/*.any.js",
            "wpt/streams/resources/*.js",
            "wpt/streams/transform-streams/*.any.js",
            "wpt/streams/writable-streams/*.any.js",
            "wpt/url/resources/*.js",
            "wpt/url/*.any.js",
            "wpt/urlpattern/resources/*.js",
            "wpt/urlpattern/*.any.js",
        ],
        exclude = [
            "wpt/common/empty.js",
        ],
    ),
)

# Other test files that will not be preprocessed
filegroup(
    name = "wpt_resources",
    srcs = glob([
        "wpt/common/empty.js",
        "wpt/url/resources/*.json",
        "wpt/urlpattern/resources/*.json",
    ]),
)
